#!/usr/bin/env bash
# Format, lint, build and test. The one verification command for Halfway.
set -euo pipefail
cd "$(dirname "$0")/.."

DERIVED_DATA="${DERIVED_DATA:-$HOME/DerivedData/halfway-slot-0}"

python3 scripts/check-release-config.py
python3 -m unittest discover -s scripts/tests
actionlint
xcodegen generate --quiet
swiftformat Halfway HalfwayTests --lint
swiftlint lint --strict --quiet

run_tests() {
  xcodebuild test \
    -project Halfway.xcodeproj \
    -scheme Halfway \
    -destination 'platform=macOS' \
    -derivedDataPath "$DERIVED_DATA" \
    "$@"
}

if command -v xcbeautify >/dev/null; then
  run_tests "$@" | xcbeautify --quiet
else
  run_tests "$@"
fi
